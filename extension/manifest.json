{
  "manifest_version": 3,
  "name": "GhostDraw",
  "version": "1.0.0",
  "description": "AI agents draw on your tldraw.com board while you watch. Works with Claude Code, Codex and MCP agents. Not affiliated with tldraw.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tldraw.com/*",
        "https://tldraw.com/*"
      ],
      "js": [
        "guide.js",
        "ghostdraw.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
